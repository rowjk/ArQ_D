# Discord Bot Token (取得自 Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (選填，啟用完整 AI 大腦與 Google 搜尋)
GEMINI_API_KEY=your_gemini_api_key_here

# 授權使用者的 Discord User ID (必填！多個 ID 請用逗號分隔)
# ⚠️ 未設定或格式錯誤時，所有人都會被拒絕。不知道自己的 ID？先啟動 bot 並私訊它，它會回覆您的 ID。
ALLOWED_USER_IDS=your_discord_user_id_here

# 使用的模型 (預設: gemini-3.8-flash，亦可填入 gemini-flash-latest 或 gemini-2.5-pro)
GEMINI_MODEL=gemini-3.8-flash

# ---------------- 節省 Gemini Token (皆為選填) ----------------
# thinking 等級：low / medium / high / default (交給模型預設)；thinking Token 以輸出價格計費
# 一般訊息 (預設 low)
# GEMINI_THINKING_LEVEL=low
# 需要規劃的訊息 (開頭「深思」、含拆解 / 規劃 / 規格 / 設計 / 架構 / 開發，或已派工給 RD；預設 high)
# GEMINI_DEEP_THINKING_LEVEL=high
# 對話歷史上限 (每次呼叫都會重送整段歷史)：超過任一上限就丟棄最舊的一輪
# GEMINI_HISTORY_TURNS=6
# GEMINI_HISTORY_CHARS=15000
# 歷史中每個工具結果最多保留的字數 (讀檔、指令輸出等用完後縮成摘要；預設 600)
# GEMINI_HISTORY_TOOL_RESULT_CHARS=600
# 對話記憶跨重啟保存 (存 _temp/，不進版控；預設開啟)，超過幾小時的歷史重啟後不讀回 (預設 24)
# GEMINI_HISTORY_PERSIST=true
# GEMINI_HISTORY_MAX_AGE_HOURS=24
# 單則訊息的工具呼叫輪數上限 (預設 12) 與累計 Token 預算 (預設 60000)；超過預算時會跳卡片問你是否繼續
# GEMINI_MAX_TOOL_ROUNDS=12
# GEMINI_MESSAGE_TOKEN_BUDGET=60000
# 顯式快取：系統提示詞＋工具存成 Gemini 快取，這部分以快取價格計費 (預設開啟；false 關閉)
# GEMINI_EXPLICIT_CACHE=true
# 快取閒置多久自動刪除 (分鐘，預設 15；使用時會延長)
# GEMINI_EXPLICIT_CACHE_TTL_MINUTES=15

# 中央氣象署開放資料平臺授權碼 (選填，啟用台灣天氣預報 / 氣象特報工具)
# 申請：https://opendata.cwa.gov.tw/ → 會員登入 → 取得授權碼。⚠️ 只填在 .env，切勿提交到 Git
# CWA_API_KEY=your_cwa_api_key_here

# 通用 API 工具 call_api 的金鑰綁定 (選填)：<金鑰變數名稱>@<主機>[#Header名稱]，逗號分隔
# 金鑰只會送往綁定的主機 (僅 https)；省略 #Header 時以 Authorization: Bearer 傳送。金鑰值另外填在本檔，例如 GITHUB_TOKEN=...
# HTTP_API_CREDENTIALS=GITHUB_TOKEN@api.github.com,EXAMPLE_API_KEY@api.example.com#X-API-Key

# Ticket 管理 (選填，GitHub Issues)：ticket 放在哪個 repo 的 Issues，格式 owner/repo
# Token 請用 fine-grained PAT：Repository access 只選該 repo、權限開 Issues: Read and write、Pull requests: Read-only (merge 確認卡要讀 PR)。⚠️ 只填在 .env
# 初始化 label：uv run python -m tools.ticket_tools --init-labels
# TICKETS_REPO=your_github_name/your_repo
# TICKETS_GITHUB_TOKEN=your_fine_grained_token_here
# 看板同步 (選填)：ticket 改狀態時一併移動 GitHub Projects 看板的 Status 欄位。格式 owner/看板編號
# token 需用 classic PAT 並勾 project scope (fine-grained PAT 無法存取個人帳號的 Projects)；權限較大，只放在本檔
# ticket repo 是 private 時還要勾 repo scope，否則同步會出現「Could not resolve to a node with the global id」
# TICKETS_PROJECT=your_github_name/1
# TICKETS_PROJECT_TOKEN=your_classic_pat_with_project_scope

# 永豐金證券 Shioaji (選填，啟用永豐帳務 / 損益 / 報價 / 排行唯讀工具；shioaji 套件已列入依賴，`uv sync` 即安裝)
# 金鑰到 https://www.sinotrade.com.tw/newweb/PythonAPIKey/ 建立，建議只勾「行情/資料」「帳務」「正式環境」，不要勾「交易」。
# ⚠️ 只填在 .env，切勿貼到聊天或提交到 Git。SJ_PRODUCTION=true 才查正式帳務 (預設模擬)。
# SJ_API_KEY=your_shioaji_api_key_here
# SJ_SEC_KEY=your_shioaji_secret_key_here
# SJ_PRODUCTION=true

# 104 職缺爬蟲 (選填)：爬蟲專案位置，預設為 使用者家目錄\Documents\JobTracker_104
# JOB_TRACKER_DIR=D:\path\to\JobTracker_104
# 爬蟲寫入的 Google 試算表名稱 (預設 JobTracker(104))
# JOB_TRACKER_WORKBOOK=JobTracker(104)

# Antigravity CLI 執行檔 (選填)：PATH 與 %LOCALAPPDATA%\agy\bin\agy.exe 都找不到時才需要
# AGY_EXE=D:\path\to\agy.exe
# 逾時：連續幾秒沒有任何動靜才算沒反應 (預設 600)、單次總時長上限 (預設 3600)；等使用者同意的時間不計
# 逾時前已有進展時不換人，帶原對話交回同一位收尾一次
# AGY_IDLE_TIMEOUT=600
# AGY_TIMEOUT=3600
# agy 執行模式 (本帳號不支援 auto，需要時才設定)
# AGY_MODE=

# ---------------- Claude Code (RD 工程師) 設定，皆為選填 ----------------
# Anthropic API Key：若已在本機執行 `claude auth login` 登入則不需設定 (保持註解即可)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude 模型 ID (預設 claude-sonnet-5-5，即 Sonnet 5.5)
# CLAUDE_MODEL=claude-sonnet-5-5

# 權限模式 (預設 bypassPermissions：一般步驟自主執行；安裝套件與高風險指令仍會透過 hook 請您同意)
# 想收緊時改為 acceptEdits (只自動核准 task/ 內的檔案編輯)，並搭配下方 CLAUDE_ALLOWED_TOOLS
# CLAUDE_PERMISSION_MODE=bypassPermissions

# 放行的工具，逗號分隔 (僅在 acceptEdits 等嚴格模式下需要)
# CLAUDE_ALLOWED_TOOLS=Bash(python:*),Bash(pytest:*),WebSearch,WebFetch

# 逾時：同 Antigravity，閒置預設 600 秒 (需大於單一長指令，Claude 的 Bash 最長 10 分鐘)、總時長預設 3600 秒
# CLAUDE_IDLE_TIMEOUT=600
# CLAUDE_TIMEOUT=3600

# 是否在伺服器頻道中強制需要 @tag 機器人 (預設: false，即私人群組可直接打字對話；若設為 true 則需 @mention 或回覆才能觸發)
# REQUIRE_MENTION=false

# 紀錄等級 (預設 INFO；可用 DEBUG / INFO / WARNING / ERROR)，紀錄檔在 _temp/logs/arq.log (不進版控)
# ARQ_LOG_LEVEL=INFO

# scope=core 派工的 worktree 上層目錄 (預設為 ArQ 旁邊的 <ArQ 資料夾名>-worktrees)
# ARQ_WORKTREES_DIR=

# 同時執行的 RD 任務上限 (預設 2：Claude 一個、agy 一個)
# RD_MAX_PARALLEL=2

# MCP 外部工具：掛載的 server 寫在專案根目錄的 mcp_servers.json（參考 mcp_servers.example.json，不進版控）。
# 金鑰只能在該檔以 ${ENV_VAR} 引用 .env 裡的變數，不得寫死。以下皆為選填：
# 所有 MCP 工具宣告的字元預算，超出的工具不會提供給 PM（預設 4000；原生工具另計）
# ARQ_MCP_DECL_BUDGET=4000
# 單次 MCP 呼叫結果的長度上限，先遮蔽金鑰再截斷（預設 8000 字元）
# ARQ_MCP_RESULT_CHARS=8000
